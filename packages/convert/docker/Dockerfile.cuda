# Stage 1: Builder
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 as builder

RUN apt-get update && apt-get install -y python3.11 python3.11-venv python3-pip build-essential

RUN python3.11 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt pyproject.toml /build/
WORKDIR /build

# Install full GPU-enabled dependencies
RUN pip install --no-cache-dir torch sentence-transformers vllm
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 as runtime

RUN apt-get update && apt-get install -y python3.11 libpoppler-cpp-dev libmagic1 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED="1" \
    NVIDIA_VISIBLE_DEVICES="all" \
    NVIDIA_DRIVER_CAPABILITIES="compute,utility" \
    HF_HOME="/cache/huggingface"

# Declare volume to ensure host caching
VOLUME ["/cache/huggingface"]

RUN useradd -m appuser
WORKDIR /app

COPY app_orchestrator /app/app_orchestrator
COPY app_spatial_compiler /app/app_spatial_compiler
COPY app_structurizer /app/app_structurizer
COPY app_vision_encoder /app/app_vision_encoder
COPY cli.py /app/cli.py

RUN chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["python", "cli.py"]